# Copy to .env and fill in only what you use. .env is gitignored — never commit real keys.
# Ollama (default, local) needs no key.

# --model claude | claude-sonnet | claude-opus | claude:<model>
ANTHROPIC_API_KEY=

# --model gpt4o | gpt4o-mini | openai:<model>
OPENAI_API_KEY=

# --model gemini | gemini-pro | gemini:<model>
GOOGLE_API_KEY=

# Optional: raises the GitHub API rate limit for the github_trending source
GITHUB_TOKEN=

# Optional: Ollama host if not localhost
# OLLAMA_HOST=http://localhost:11434

# Optional: explicit config file path
# DAILY_BRIEF_CONFIG=/path/to/config.yaml
